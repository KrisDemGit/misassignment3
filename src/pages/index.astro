---
const services = [
	{
		number: "01",
		title: "Website Development",
		description:
			"Modern, responsive websites designed to help your business establish a strong online presence and reach more customers.",
		icon: "01",
	},
	{
		number: "02",
		title: "IT Consulting",
		description:
			"Practical technology advice and customized solutions that help businesses improve their operations and achieve their goals.",
		icon: "02",
	},
	{
		number: "03",
		title: "Digital Solutions",
		description:
			"Technology-driven solutions that streamline workflows, improve efficiency, and support your company's growth.",
		icon: "03",
	},
];

const benefits = [
	"Solutions tailored to your business",
	"Modern and reliable technology",
	"Professional and responsive design",
	"A focus on long-term business growth",
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="Startup Tech Solutions provides modern website development, IT consulting, and digital solutions to help businesses grow."
		/>
		<meta name="theme-color" content="#071426" />
		<title>
			Startup Tech Solutions | Technology That Moves Business Forward
		</title>
	</head>

	<body>
		<header class="navbar">
			<a href="#home" class="logo">
				<span class="logo-icon">ST</span>
				<span
					>STARTUP<span class="blue">TECH</span><br />
					<small>SOLUTIONS</small>
				</span>
			</a>

			<nav>
				<a href="#home">Home</a>
				<a href="#services">Services</a>
				<a href="#about">About Us</a>
				<a href="#contact" class="nav-button">Get in Touch ↗</a>
			</nav>
		</header>

		<main>
			<section class="hero" id="home">
				<div class="hero-content">
					<div class="eyebrow">
						<span class="status-dot"></span>
						YOUR PARTNER IN DIGITAL GROWTH
					</div>

					<h1>
						Technology That Moves
						<span>Your Business Forward.</span>
					</h1>

					<p class="hero-description">
						Empowering businesses with innovative technology, modern
						digital solutions, and professional services designed to
						help you grow.
					</p>

					<div class="hero-buttons">
						<a href="#services" class="primary-button">
							Explore Our Services →
						</a>
						<a href="#about" class="secondary-button">
							Discover Our Company
						</a>
					</div>

					<div class="hero-note">
						<span class="note-line"></span>
						INNOVATION · TECHNOLOGY · GROWTH
					</div>
				</div>

				<div class="hero-visual">
					<div class="glow"></div>
					<div class="tech-card">
						<div class="card-top">
							<span class="card-label"
								>TECHNOLOGY & INNOVATION</span
							>
							<span class="live-dot"></span>
						</div>

						<div class="orbit">
							<div class="orbit-ring ring-one"></div>
							<div class="orbit-ring ring-two"></div>
							<div class="orbit-ring ring-three"></div>
							<div class="center-logo">ST</div>
							<div class="orbit-node node-one">✦</div>
							<div class="orbit-node node-two">⌘</div>
							<div class="orbit-node node-three">↗</div>
						</div>

						<div class="card-bottom">
							<div>
								<strong>Think Bigger.</strong>
								<p>Build Smarter. Grow Faster.</p>
							</div>
							<span class="arrow-circle">↗</span>
						</div>
					</div>

					<div class="floating-tag tag-one">
						<span class="tag-symbol">✦</span>
						Innovation
					</div>
					<div class="floating-tag tag-two">
						<span class="tag-symbol">⌘</span>
						Technology
					</div>
				</div>
			</section>

			<section class="intro-strip">
				<div>SMARTER TECHNOLOGY</div>
				<span>✦</span>
				<div>BETTER SOLUTIONS</div>
				<span>✦</span>
				<div>STRONGER BUSINESSES</div>
			</section>

			<section class="services section" id="services">
				<div class="section-heading">
					<div class="eyebrow">WHAT WE DO</div>
					<h2>
						Technology Solutions<br />Built for <span>Growth.</span>
					</h2>
					<p>
						We combine technology and creativity to help businesses
						solve problems, improve performance, and reach their
						potential.
					</p>
				</div>

				<div class="service-grid">
					{
						services.map((service) => (
							<article class="service-card">
								<div class="service-number">
									{service.number}
								</div>
								<div class="service-icon">✧</div>
								<h3>{service.title}</h3>
								<p>{service.description}</p>
								<a href="#contact" class="service-link">
									Learn More <span>↗</span>
								</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="about section" id="about">
				<div class="about-visual">
					<div class="about-panel">
						<div class="panel-orbit"></div>
						<div class="panel-content">
							<span>OUR APPROACH</span>
							<h3>Turning Ideas Into Possibilities.</h3>
							<div class="panel-line"></div>
							<p>Innovation starts with the right solution.</p>
						</div>
						<div class="panel-decoration">ST.</div>
					</div>
				</div>

				<div class="about-content">
					<div class="eyebrow">ABOUT STARTUP TECH SOLUTIONS</div>
					<h2>
						Helping Businesses<br />Navigate the <span
							>Future.</span>
					</h2>
					<p>
						At Startup Tech Solutions, we believe technology should
						make business easier, smarter, and more efficient.
					</p>
					<p>
						Our goal is to provide businesses with modern technology
						solutions that address their unique challenges. Whether
						you're establishing your online presence or improving
						existing operations, we're here to help you move
						forward.
					</p>

					<ul class="benefit-list">
						{
							benefits.map((benefit) => {
								return (
									<Fragment>
										<li>
											<span>✓</span>
											{benefit}
										</li>
									</Fragment>
								);
							})
						}
					</ul>

					<a href="#contact" class="primary-button">
						Get to Know Us →
					</a>
				</div>
			</section>

			<section class="cta-section" id="contact">
				<div class="cta-glow"></div>
				<div class="eyebrow">LET'S BUILD SOMETHING GREAT</div>
				<h2>
					Ready to Take Your<br />Business to the <span
						>Next Level?</span>
				</h2>
				<p>
					Let's explore how the right technology can help your
					business grow, innovate, and succeed.
				</p>
				<a href="#home" class="primary-button">
					Start Your Journey ↑
				</a>
				<div class="contact-note">
					Contact Startup Tech Solutions to discuss your next project.
				</div>
			</section>
		</main>

		<footer>
			<a href="#home" class="logo footer-logo">
				<span class="logo-icon">ST</span>
				<span
					>STARTUP<span class="blue">TECH</span><br />
					<small>SOLUTIONS</small>
				</span>
			</a>
			<p>
				© {new Date().getFullYear()} Startup Tech Solutions. All rights reserved.
			</p>
			<a href="#home" class="back-top">Back to top ↑</a>
		</footer>
	</body>
</html>

<style>
	@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap");

	:global(*) {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 90px;
	}

	:global(body) {
		font-family: "DM Sans", sans-serif;
		background: #ffffff;
		color: #101d31;
		overflow-x: hidden;
	}

	.navbar {
		height: 84px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 8%;
		background: #ffffff;
		position: sticky;
		top: 0;
		z-index: 100;
		box-shadow: 0 2px 15px rgba(0, 0, 0, 0.04);
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: #10213b;
		font-size: 15px;
		font-weight: 800;
		letter-spacing: -0.5px;
		line-height: 1.15;
	}

	.logo small {
		font-size: 10px;
		letter-spacing: 3px;
		color: #64748b;
	}

	.logo-icon {
		width: 43px;
		height: 43px;
		display: grid;
		place-items: center;
		background: #1266db;
		color: white;
		border-radius: 11px;
		font-family: "Space Grotesk", sans-serif;
		font-size: 17px;
	}

	.blue {
		color: #3182ed;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 34px;
	}

	nav a {
		text-decoration: none;
		color: #46546a;
		font-size: 13px;
		font-weight: 600;
		transition: color 0.2s;
	}

	nav a:hover {
		color: #1670e8;
	}

	nav .nav-button {
		background: #1266db;
		color: white;
		padding: 13px 21px;
		border-radius: 6px;
	}

	.hero {
		min-height: 620px;
		background: #071426;
		color: white;
		padding: 90px 10%;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		align-items: center;
		gap: 45px;
		overflow: hidden;
		position: relative;
	}

	.hero::before {
		content: "";
		position: absolute;
		width: 600px;
		height: 600px;
		right: -150px;
		top: -200px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			rgba(31, 110, 231, 0.17),
			transparent 70%
		);
	}

	.eyebrow {
		color: #3189ff;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 2px;
		margin-bottom: 22px;
	}

	.status-dot,
	.live-dot {
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #3fdbb0;
		margin-right: 8px;
	}

	.hero h1,
	h2 {
		font-family: "Space Grotesk", sans-serif;
		font-weight: 700;
		letter-spacing: -2px;
	}

	.hero h1 {
		font-size: clamp(39px, 5vw, 61px);
		line-height: 1.13;
		max-width: 630px;
	}

	.hero h1 span {
		color: #438fff;
		display: block;
	}

	.hero-description {
		color: #a9b8cb;
		font-size: 15px;
		line-height: 1.9;
		max-width: 510px;
		margin-top: 25px;
	}

	.hero-buttons {
		display: flex;
		gap: 15px;
		flex-wrap: wrap;
		margin-top: 34px;
	}

	.primary-button,
	.secondary-button {
		padding: 15px 22px;
		border-radius: 6px;
		text-decoration: none;
		font-size: 13px;
		font-weight: 700;
		display: inline-block;
		transition: 0.2s;
	}

	.primary-button {
		background: #2679ed;
		color: white;
	}

	.primary-button:hover {
		background: #105dc9;
		transform: translateY(-2px);
	}

	.secondary-button {
		border: 1px solid #45566e;
		color: white;
	}

	.secondary-button:hover {
		background: #162b46;
	}

	.hero-note {
		color: #8193aa;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 2px;
		margin-top: 60px;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.note-line {
		height: 1px;
		width: 35px;
		background: #3189ff;
	}

	.hero-visual {
		min-height: 380px;
		display: grid;
		place-items: center;
		position: relative;
	}

	.glow {
		position: absolute;
		width: 330px;
		height: 330px;
		border-radius: 50%;
		background: rgba(28, 107, 239, 0.16);
		filter: blur(65px);
	}

	.tech-card {
		width: min(100%, 390px);
		height: 365px;
		border: 1px solid rgba(117, 165, 255, 0.3);
		background: linear-gradient(140deg, #142b49, #0c1b30);
		border-radius: 20px;
		padding: 23px;
		position: relative;
		z-index: 1;
		box-shadow: 0 25px 70px rgba(0, 0, 0, 0.3);
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		color: #8fa6c2;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 2px;
	}

	.orbit {
		height: 240px;
		display: grid;
		place-items: center;
		position: relative;
	}

	.orbit-ring {
		position: absolute;
		border: 1px solid rgba(75, 145, 255, 0.3);
		border-radius: 50%;
	}

	.ring-one {
		width: 115px;
		height: 115px;
	}
	.ring-two {
		width: 185px;
		height: 185px;
	}
	.ring-three {
		width: 230px;
		height: 230px;
	}

	.center-logo {
		width: 75px;
		height: 75px;
		background: linear-gradient(135deg, #3189ff, #1551b3);
		border-radius: 20px;
		display: grid;
		place-items: center;
		font-size: 25px;
		font-weight: 800;
		box-shadow: 0 0 45px rgba(49, 137, 255, 0.4);
		z-index: 2;
	}

	.orbit-node {
		position: absolute;
		background: #193c67;
		border: 1px solid #438fff;
		border-radius: 50%;
		width: 36px;
		height: 36px;
		display: grid;
		place-items: center;
		color: #77b2ff;
		z-index: 3;
	}

	.node-one {
		top: 12px;
		left: 100px;
	}
	.node-two {
		bottom: 20px;
		right: 65px;
	}
	.node-three {
		top: 55px;
		right: 65px;
	}

	.card-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-top: 17px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.card-bottom strong {
		font-size: 15px;
	}
	.card-bottom p {
		color: #8fa6c2;
		font-size: 11px;
		margin-top: 5px;
	}

	.arrow-circle {
		border: 1px solid #438fff;
		border-radius: 50%;
		padding: 9px 11px;
		color: #72aaff;
	}

	.floating-tag {
		position: absolute;
		z-index: 4;
		background: #193351;
		border: 1px solid #365b84;
		border-radius: 8px;
		padding: 12px 16px;
		font-size: 11px;
		font-weight: 700;
		color: #d6e7ff;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
	}

	.tag-one {
		top: 45px;
		right: -10px;
	}
	.tag-two {
		bottom: 40px;
		left: -20px;
	}
	.tag-symbol {
		color: #52a0ff;
		margin-right: 7px;
	}

	.intro-strip {
		background: #f1f6fc;
		padding: 24px 8%;
		display: flex;
		align-items: center;
		justify-content: space-around;
		gap: 20px;
		flex-wrap: wrap;
		color: #354b67;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 1.5px;
	}

	.intro-strip span {
		color: #3388f7;
	}

	.section {
		padding: 105px 10%;
	}

	.section-heading {
		max-width: 650px;
		margin-bottom: 48px;
	}

	.section-heading h2,
	.about-content h2 {
		font-size: clamp(33px, 4vw, 45px);
		line-height: 1.2;
	}

	.section-heading h2 span,
	.about-content h2 span {
		color: #2879e6;
	}

	.section-heading > p {
		color: #718096;
		font-size: 14px;
		line-height: 1.8;
		max-width: 520px;
		margin-top: 18px;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
	}

	.service-card {
		border: 1px solid #e5ebf3;
		border-radius: 12px;
		padding: 30px 26px;
		position: relative;
		transition: 0.25s;
		background: white;
	}

	.service-card:hover {
		transform: translateY(-7px);
		border-color: #8abaff;
		box-shadow: 0 15px 35px rgba(21, 78, 145, 0.09);
	}

	.service-number {
		position: absolute;
		right: 25px;
		top: 25px;
		color: #b8c7d9;
		font-size: 12px;
		font-weight: 800;
	}

	.service-icon {
		width: 48px;
		height: 48px;
		display: grid;
		place-items: center;
		background: #edf5ff;
		color: #2679ed;
		border-radius: 10px;
		font-size: 28px;
	}

	.service-card h3 {
		font-family: "Space Grotesk", sans-serif;
		font-size: 19px;
		margin: 25px 0 12px;
	}

	.service-card p {
		color: #748196;
		font-size: 13px;
		line-height: 1.9;
		min-height: 100px;
	}

	.service-link {
		color: #2374df;
		font-size: 12px;
		font-weight: 800;
		text-decoration: none;
		display: flex;
		justify-content: space-between;
		margin-top: 24px;
		border-top: 1px solid #edf0f5;
		padding-top: 18px;
	}

	.about {
		background: #f5f8fc;
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		align-items: center;
		gap: 85px;
	}

	.about-panel {
		min-height: 390px;
		border-radius: 16px;
		background: linear-gradient(145deg, #102e50, #071426);
		color: white;
		padding: 40px;
		display: flex;
		align-items: center;
		position: relative;
		overflow: hidden;
		box-shadow: 0 20px 50px rgba(7, 20, 38, 0.15);
	}

	.panel-orbit {
		position: absolute;
		width: 350px;
		height: 350px;
		border: 1px solid rgba(76, 147, 255, 0.3);
		border-radius: 50%;
		right: -160px;
		top: -120px;
		box-shadow:
			0 0 0 40px rgba(76, 147, 255, 0.04),
			0 0 0 80px rgba(76, 147, 255, 0.04);
	}

	.panel-content {
		position: relative;
		z-index: 2;
	}

	.panel-content > span {
		color: #64a8ff;
		letter-spacing: 2px;
		font-size: 10px;
		font-weight: 800;
	}

	.panel-content h3 {
		font-family: "Space Grotesk", sans-serif;
		font-size: 32px;
		line-height: 1.25;
		margin: 20px 0;
		max-width: 270px;
	}

	.panel-line {
		height: 3px;
		width: 45px;
		background: #398bfa;
		margin-bottom: 20px;
	}

	.panel-content p {
		color: #a4b9d1;
		font-size: 12px;
	}

	.panel-decoration {
		position: absolute;
		right: 20px;
		bottom: 10px;
		color: rgba(255, 255, 255, 0.05);
		font-size: 110px;
		font-weight: 800;
	}

	.about-content > p {
		color: #718096;
		font-size: 14px;
		line-height: 1.9;
		margin-top: 20px;
	}

	.benefit-list {
		list-style: none;
		margin: 26px 0 30px;
	}

	.benefit-list li {
		margin: 13px 0;
		color: #35465d;
		font-size: 13px;
		font-weight: 600;
	}

	.benefit-list li span {
		color: #2379e8;
		font-weight: 800;
		margin-right: 12px;
	}

	.cta-section {
		background: #08172a;
		color: white;
		text-align: center;
		padding: 100px 20px;
		position: relative;
		overflow: hidden;
	}

	.cta-glow {
		position: absolute;
		width: 450px;
		height: 450px;
		background: rgba(32, 108, 229, 0.14);
		filter: blur(90px);
		border-radius: 50%;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
	}

	.cta-section > *:not(.cta-glow) {
		position: relative;
	}

	.cta-section h2 {
		font-size: clamp(35px, 5vw, 49px);
		line-height: 1.2;
	}

	.cta-section h2 span {
		color: #438fff;
	}

	.cta-section > p {
		max-width: 530px;
		margin: 20px auto 30px;
		color: #a5b5ca;
		font-size: 14px;
		line-height: 1.8;
	}

	.contact-note {
		margin-top: 25px;
		color: #8294aa;
		font-size: 11px;
	}

	footer {
		min-height: 100px;
		padding: 25px 8%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		flex-wrap: wrap;
	}

	footer p,
	.back-top {
		color: #8190a4;
		font-size: 11px;
	}

	.back-top {
		text-decoration: none;
		font-weight: 700;
	}

